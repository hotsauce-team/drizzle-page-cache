{
  "name": "@hotsauce/drizzle-page-cache",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./litespeed": "./src/dialects/litespeed.ts",
    "./souin": "./src/dialects/souin.ts",
    "./surrogate-key": "./src/dialects/surrogate-key.ts",
    "./xkey": "./src/dialects/xkey.ts",
    "./varnish": "./src/dialects/varnish.ts",
    "./angie": "./src/dialects/angie.ts",
    "./nginx": "./src/dialects/nginx.ts"
  },
  "license": "MIT",

  "tasks": {
    "test": "deno test --allow-env --allow-read tests/",
    "check": "deno check src/ tests/",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },

  "imports": {
    "drizzle-orm": "npm:drizzle-orm@^0.45.1",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.1"
  },

  "publish": {
    "include": [
      "src/",
      "nginx/",
      "README.md",
      "LICENSE"
    ],
    "exclude": ["tests/", "e2e/", "scripts/"]
  },

  "compilerOptions": {
    "strict": true
  }
}
