{
  "name": "@hotsauce/drizzle-page-cache",
  "version": "0.1.0",
  "exports": {
    ".": "./mod.ts",
    "./litespeed": "./litespeed/mod.ts",
    "./souin": "./souin/mod.ts",
    "./surrogate-key": "./surrogate-key/mod.ts",
    "./xkey": "./xkey/mod.ts",
    "./varnish": "./varnish/mod.ts",
    "./angie": "./angie/mod.ts",
    "./nginx": "./nginx/mod.ts"
  },
  "license": "MIT",

  "tasks": {
    "test": "deno test --allow-env --allow-read tests/",
    "check": "deno check mod.ts litespeed/mod.ts souin/mod.ts surrogate-key/mod.ts xkey/mod.ts varnish/mod.ts angie/mod.ts nginx/mod.ts tests/",
    "build:npm": "deno run -A scripts/build_npm.ts"
  },

  "imports": {
    "drizzle-orm": "npm:drizzle-orm@^0.45.1",
    "@std/assert": "jsr:@std/assert@^1.0.6",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.1"
  },

  "publish": {
    "include": [
      "mod.ts",
      "*.ts",
      "litespeed/",
      "souin/",
      "surrogate-key/",
      "xkey/",
      "varnish/",
      "angie/",
      "nginx/",
      "README.md",
      "LICENSE"
    ],
    "exclude": ["tests/", "e2e/", "scripts/"]
  },

  "compilerOptions": {
    "strict": true
  }
}
