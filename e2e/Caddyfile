{
	order cache before rewrite
	# `header` must sit OUTSIDE `cache` in the chain so its egress cleanup runs
	# AFTER Souin has read and stored Surrogate-Key — otherwise the strip below
	# would remove the tag before Souin indexes it and purging would break.
	order header before cache
	cache {
		ttl 300s
		otter
		storers otter
		api {
			souin
		}
	}
	auto_https off
	servers {
		protocols h1
	}
}

# {env.UPSTREAM} is resolved by Caddy at RUNTIME (unlike {$UPSTREAM}, which
# `caddy adapt` would bake in at generation time) — one shared caddy.json
# serves all three pairings, each container dialing its own app via the
# UPSTREAM env var in docker-compose.yml.
:80 {
	# Don't leak the tags to clients: Surrogate-Key carries schema names and
	# row IDs. Souin still reads it upstream (ordered above); this strips it
	# from the client-facing response only.
	header -Surrogate-Key
	cache
	reverse_proxy {env.UPSTREAM}
}

# TLS listener for the handshake-stress bench. Session tickets are disabled
# in the generated JSON (gen-caddy-json.sh) so every connection pays a full
# handshake — the Caddyfile cannot express that.
:443 {
	tls /certs/cert.pem /certs/key.pem
	header -Surrogate-Key
	cache
	reverse_proxy {env.UPSTREAM}
}
